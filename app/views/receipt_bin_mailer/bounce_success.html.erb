<p>
We got your <%= "receipt".pluralize(@receipts_count) %>, thanks!
<% unless @receipts_count == @paired_with.size %>
You can find <%= @receipts_count == 1 ? "it" : "them" %> in your <%= link_to("Receipt Bin", my_inbox_url) %>.
<% end %>
</p>

<% if @paired_with.any? %>
  <p>We also automatically matched <%= @receipts_count == 1 ? "it" : "#{@paired_with.size} #{"receipt".pluralize(@paired_with.size)}" %> to the following <%= "transaction".pluralize(@paired_with.size) %>:</p>

  <ul>
    <%# Each is the ledger item the receipt was attached to. Reversing a pairing
        is still offered on the HCB code page (see HcbCodesController#show). %>
    <% @paired_with.each do |ledger_item| %>
      <li><%= link_to ledger_item.memo, ledger_item_url(ledger_item) %> from <%= time_ago_in_words ledger_item.datetime %> ago - <%= link_to "click to reverse this pairing", hcb_code_url(ledger_item.hcb_code, reverse: ledger_item.receipts.last.id) %></li>
    <% end %>
  </ul>
<% end %>

<p>
  From,<br>
  The HCB Team
</p>
